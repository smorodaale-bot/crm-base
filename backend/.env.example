DATABASE_URL="postgresql://crm:crm@localhost:5432/crm_base?schema=public"
JWT_SECRET="change-me-to-a-long-random-secret-in-production"
JWT_REFRESH_SECRET="change-me-refresh-secret-too"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=4001
CORS_ORIGIN="http://localhost:5173"
COOKIE_SECURE="false"
# Lead SLA (minutes until supervisor escalate)
LEAD_SLA_MINUTES=15
# Public website lead form token (optional; if set, require X-Lead-Token)
# LEAD_PUBLIC_TOKEN=
# In production LEAD_PUBLIC_TOKEN fallback is disabled unless:
# ALLOW_LEGACY_LEAD_TOKEN=1
# Demo payment complete is disabled in production unless:
# ALLOW_DEMO_PAY=1
# Avito webhook token (falls back to LEAD_PUBLIC_TOKEN)
# AVITO_WEBHOOK_TOKEN=
# WhatsApp webhook (Green-API / Meta). Meta verify uses WHATSAPP_VERIFY_TOKEN
# WHATSAPP_WEBHOOK_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
# Optional platform Telegram fallback. Prefer org bot: Орг → Каналы → Telegram
# (same bot sends inbound leads + manager/director alerts).
# TELEGRAM_BOT_TOKEN=
# PUBLIC_APP_URL=https://nova-crm.online
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_WORKER_URL=https://your-worker.workers.dev
# MAX messenger bot uses org settings in CRM (token from https://dev.max.ru).
# Webhook: https://your-domain/api/webhooks/max/:orgId
# DEFAULT_SALON_SLUG=skayavto-msk
# Stock / 1C webhook token (optional; if unset, sync requires supervisor JWT)
# Токен синхронизации склада задаётся в организации (Настройки), не через этот файл.
# STOCK_WEBHOOK_TOKEN=
# Опционально: LLM-усиление резюме QC + SpeechKit
# YandexGPT / SpeechKit (приоритет на VPS):
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=
# YANDEX_GPT_MODEL=yandexgpt-lite
# SPEECHKIT_LANG=ru-RU
# SPEECHKIT_TOPIC=general
# OpenAI (альтернатива / Whisper):
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Код на почту при входе и регистрации. false — временный вход без письма.
# AUTH_EMAIL_OTP=true
# Скидка −50% на первые 3 месяца помесячной оплаты для первых 30 организаций.
# Включена, пока не задано EARLY_PROMO=false.
# EARLY_PROMO=true
# SMTP для кода входа на почту (без SMTP код пишется в лог и отдаётся как devCode только вне production)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Nova CRM <noreply@nova-crm.online>"
# Почта поддержки: Reply-To в письмах и контакт на сайте (GET /api/auth/config).
SUPPORT_EMAIL=support@nova-crm.online
# APP_NAME=Nova CRM
# OTP_DEV_CODE=true
# ЮKassa (подписка). Без ключей работает YOOKASSA_DEMO (локальное подтверждение).
PUBLIC_APP_URL=http://localhost:5173
YOOKASSA_RETURN_URL=http://localhost:5173/org/billing?payment=success
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# YOOKASSA_DEMO=true
# Webhook URL в кабинете ЮKassa: https://your-domain/api/billing/yookassa/webhook
